---
interface Props {
  url: string;
}
const { url } = Astro.props;

const base = "https://publish.twitter.com/oembed";
const baseUrl = new URL(base);
baseUrl.searchParams.set("url", url);
baseUrl.searchParams.set("omit_script", "true");

const tweet = await fetch(baseUrl.toString())
  .then<{ html: string }>((res) => res.json())
  .catch((err) => {
  console.error("Error fetching tweet:", err);
  return null;
});
---

{
  tweet && (
    <>
      <div class="tweet-embed">
        <div set:html={tweet.html} style="width: 100%; height: auto;" />
      </div>
      <script
        async
        charset="utf-8"
        crossorigin="anonymous"
        src="https://platform.twitter.com/widgets.js"
      />
    </>
  )
}


<style>
  .tweet-embed {
    width: 100%;
    max-width: 360px;
    margin-inline: 0;
    min-width: 0;
  }

  :global(.tweet-grid) {
    display: grid;
    grid-template-columns: minmax(0, 360px);
    gap: 16px;
    align-items: start;
  }

  @media (min-width: 640px) {
    :global(.tweet-grid) {
      grid-template-columns: repeat(2, minmax(0, 360px));
    }
  }
</style>

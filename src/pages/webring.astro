- https://hpcb-mass.com/
- https://www.sigfpe.info/
- https://rakugan.jp/
- https://nqme.net/
`;

const links = linksText
	.trim()
	.split("\n")
	.map((v) => v.replace(/^- /, "").trim())
	.filter(Boolean);

interface DomainNode {
	children: DomainNode[];
	label: string;
	links: string[];
}

interface MutableDomainNode {
	children: Map<string, MutableDomainNode>;
	label: string;
	links: Set<string>;
}

const domainRoots = new Map<string, MutableDomainNode>();

for (const link of new Set(links)) {
	const labels = domainToUnicode(new URL(link).hostname)
		.toLowerCase()
		.split(".")
		.filter((label) => label !== "www")
		.reverse();
	let siblings = domainRoots;
	let currentNode: MutableDomainNode | undefined;

	for (const label of labels) {
		currentNode = siblings.get(label);
		if (!currentNode) {
			currentNode = { children: new Map(), label, links: new Set() };
			siblings.set(label, currentNode);
		}
		siblings = currentNode.children;
	}

	currentNode?.links.add(link);
}

function serializeTree(nodes: Map<string, MutableDomainNode>): DomainNode[] {
	return [...nodes.values()]
		.sort((a, b) => a.label.localeCompare(b.label))
		.map((node) => ({
			children: serializeTree(node.children),
			label: node.label,
			links: [...node.links].sort(),
		}));
}

const domainTree = serializeTree(domainRoots);
---

<PageLayout meta={{ title: "links" }}>
	<div
		class="prose-sm prose-cactus prose-headings:pl-4 prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-accent prose-headings:before:content-['#'] prose-th:before:content-none"
	>
		<h1 class="title">webring</h1>

		<DomainTree nodes={domainTree} />
	</div>
</PageLayout>
